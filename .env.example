# ===========================================
# オンラインバックオフィス代行 MVP
# ===========================================

# Supabase
# Supabase Dashboard > Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (メール送信)
# https://resend.com/api-keys から取得
RESEND_API_KEY=re_test_xxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# サイトURL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Calendly (商談予約 - 設定しない場合は簡易フォームにフォールバック)
NEXT_PUBLIC_CALENDLY_URL=

# Calendly Webhook 署名キー (HMAC-SHA256検証)
CALENDLY_WEBHOOK_SECRET=

# 新規リード通知 (メール宛先 - 未設定時は通知なし)
NOTIFICATION_EMAIL=

# Slack Webhook URL (新規リード通知 - 未設定時は通知なし)
SLACK_WEBHOOK_URL=

# Cron Secret (Vercel Cron のセキュリティ - vercel.json の crons と連動)
CRON_SECRET=

# Sentry (エラー監視)
# https://sentry.io からプロジェクト作成後に取得
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_STANDARD_PRICE_ID=price_...
STRIPE_STANDARD_INITIAL_PRICE_ID=price_...
SLACK_WEBHOOK_URL=https://hooks.slack.com/...
